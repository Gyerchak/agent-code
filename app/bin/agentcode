#!/bin/sh
# Agent Code: Claude Code with an opencode-style TUI
DIR="$(dirname "$(readlink -f "$0")")/.."

# agentcode needs Node >= 26 (--experimental-ffi). Desktop launchers (.desktop, systemd) don't load the shell's
# nvm PATH and may find an older system node, so pick the first Node 26+ from: $OCC_NODE, PATH, nvm, system.
major() { "$1" -p 'process.versions.node.split(".")[0]' 2>/dev/null; }
NODE=""
for candidate in ${OCC_NODE:-} "$(command -v node 2>/dev/null)" $(ls -d "${NVM_DIR:-$HOME/.nvm}"/versions/node/v*/bin/node 2>/dev/null | sort -rV) /usr/local/bin/node /usr/bin/node; do
  [ -n "$candidate" ] && [ -x "$candidate" ] || continue
  v="$(major "$candidate")"
  if [ -n "$v" ] && [ "$v" -ge 26 ] 2>/dev/null; then NODE="$candidate"; break; fi
done
if [ -z "$NODE" ]; then
  echo "agentcode needs Node.js 26 or newer (found: $(node --version 2>/dev/null || echo none) at $(command -v node 2>/dev/null || echo -))." >&2
  echo "Install it (e.g. nvm install 26) or point OCC_NODE at a node binary." >&2
  exit 1
fi
# A fresh download or copy has no build yet, and a pull leaves an old one: build it here. A failed rebuild keeps the old one.
if [ ! -f "$DIR/dist/index.js" ] || [ -n "$(find "$DIR/src" -type f -newer "$DIR/dist/index.js" 2>/dev/null | head -n 1)" ]; then
  echo "agentcode: building…" >&2
  (
    cd "$DIR" || exit 1
    PATH="$(dirname "$NODE"):$PATH"
    [ -d node_modules ] || npm ci >&2 || exit 1
    npm run build >&2
  ) || echo "agentcode: the build failed (run npm ci && npm run build in $DIR)." >&2
  if [ ! -f "$DIR/dist/index.js" ]; then exit 1; fi
fi
# agentcode-window runs Alacritty through XWayland (so dropped files arrive): agentcode itself still talks to Wayland.
if [ -z "${WAYLAND_DISPLAY:-}" ] && [ -n "${OCC_WAYLAND_DISPLAY:-}" ]; then export WAYLAND_DISPLAY="$OCC_WAYLAND_DISPLAY"; fi
exec "$NODE" --experimental-ffi --no-warnings "$DIR/dist/index.js" "$@"
