#!/bin/sh
# acode-window — open a terminal window running acode (or the given command) in which files dropped onto the
# window reach acode.
#
#   acode-window                         acode in a new window (in the current folder)
#   acode-window --title NAME CMD [ARG…] CMD in a new window titled NAME
#
# Alacritty cannot receive dropped files on Wayland (its windowing library, winit 0.30, has no Wayland
# drag-and-drop), so it is started through XWayland, where drops arrive as a paste of the file's path. The
# command inside gets WAYLAND_DISPLAY back (bin/acode restores it), so the clipboard keeps working.
DIR="$(dirname "$(readlink -f "$0")")"
TITLE="acode"
if [ "${1:-}" = "--title" ] && [ -n "${2:-}" ]; then TITLE="$2"; shift 2; fi
[ $# -gt 0 ] || set -- "$DIR/acode"

TERM_APP="${TERMINAL:-}"
if [ -z "$TERM_APP" ]; then
  for t in alacritty konsole kitty foot wezterm gnome-terminal xfce4-terminal xterm; do
    command -v "$t" >/dev/null 2>&1 && { TERM_APP="$t"; break; }
  done
fi
# No padding, and a window that resizes in whole character cells: nothing is left over around the app.
FIT="-o window.opacity=1.0 -o window.padding.x=0 -o window.padding.y=0 -o window.dynamic_padding=true -o window.resize_increments=true"
case "$(basename "${TERM_APP:-}")" in
  alacritty)
    if [ -n "${WAYLAND_DISPLAY:-}" ] && [ -n "${DISPLAY:-}" ]; then
      exec env -u WAYLAND_DISPLAY ACODE_WAYLAND_DISPLAY="$WAYLAND_DISPLAY" alacritty $FIT --title "$TITLE" -e "$@"
    fi
    exec alacritty $FIT --title "$TITLE" -e "$@" ;;
  konsole) exec konsole -e "$@" ;;
  kitty) exec kitty --title "$TITLE" "$@" ;;
  foot) exec foot --title "$TITLE" "$@" ;;
  wezterm) exec wezterm start -- "$@" ;;
  gnome-terminal) exec gnome-terminal -- "$@" ;;
  xfce4-terminal) exec xfce4-terminal --title "$TITLE" -x "$@" ;;
  xterm) exec xterm -T "$TITLE" -e "$@" ;;
  "") echo "acode-window: no terminal emulator found" >&2; exit 1 ;;
  *) exec "$TERM_APP" -e "$@" ;;
esac
